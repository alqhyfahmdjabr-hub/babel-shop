---
import { site } from "../config/site";
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-babil-black/70 backdrop-blur-xl">
  <div class="container flex items-center justify-between py-4">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/logo.svg" alt={site.name} class="h-10 w-10" />
      <div class="leading-tight">
        <div class="text-base font-extrabold text-white">{site.name}</div>
        <div class="text-xs text-brand-200/80">{site.tagline}</div>
      </div>
    </a>

    <nav class="hidden items-center gap-6 text-sm text-gray-300 md:flex" aria-label="التنقل الرئيسي">
      <a class="hover:text-white" href="#prices">الأسعار</a>
      <a class="hover:text-white" href="#catalog">الكتالوج</a>
      <a class="hover:text-white" href="#studio">الاستوديو</a>
      <a class="hover:text-white" href="#features">المميزات</a>
      <a class="hover:text-white" href="#screens">لقطات</a>
      <a class="hover:text-white" href="#trial">اطلب</a>
    </nav>

    <div class="flex items-center gap-3">
      <a href="#trial" class="hidden items-center md:inline-flex btn-primary px-4 py-2">
        اطلب الآن
      </a>

      <details class="relative md:hidden">
        <summary
          class="list-none rounded-2xl border border-white/10 bg-white/5 px-3 py-2 text-sm font-bold text-white hover:bg-white/10"
          aria-label="فتح قائمة التنقل"
        >
          القائمة
        </summary>
        <div class="absolute left-0 z-20 mt-2 w-56 overflow-hidden rounded-3xl border border-white/10 bg-babil-card shadow-luxury">
          <nav class="grid gap-1 p-2 text-sm text-gray-200" aria-label="قائمة التنقل للموبايل">
            <a class="rounded-2xl px-3 py-2 hover:bg-white/5" href="#prices">الأسعار</a>
            <a class="rounded-2xl px-3 py-2 hover:bg-white/5" href="#catalog">الكتالوج</a>
            <a class="rounded-2xl px-3 py-2 hover:bg-white/5" href="#studio">الاستوديو</a>
            <a class="rounded-2xl px-3 py-2 hover:bg-white/5" href="#features">المميزات</a>
            <a class="rounded-2xl px-3 py-2 hover:bg-white/5" href="#screens">لقطات</a>
            <a class="rounded-2xl px-3 py-2 hover:bg-white/5" href="#trial">اطلب</a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
