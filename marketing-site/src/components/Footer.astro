---
import { site } from "../config/site";

const phoneHref = `tel:${site.contact.phone.replace(/\s+/g, "")}`;
const whatsappHref = `https://wa.me/${site.contact.whatsapp.replace(/[^\d]/g, "")}`;
const whatsappAltHref = site.contact.whatsappAlt ? `https://wa.me/${site.contact.whatsappAlt.replace(/[^\d]/g, "")}` : "";
const mailHref = `mailto:${site.contact.email}`;
---

<footer class="border-t border-white/10 bg-babil-black">
  <div class="container grid gap-8 py-12 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-3">
        <img src="/images/logo.svg" alt={site.name} class="h-11 w-11" />
        <div>
          <div class="font-extrabold text-white">{site.name}</div>
          <div class="text-xs text-brand-200/80">{site.tagline}</div>
        </div>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-gray-400">{site.description}</p>
    </div>

    <div class="text-sm">
      <div class="font-semibold text-white">روابط</div>
      <ul class="mt-4 space-y-2 text-gray-300">
        <li><a class="hover:text-white" href="/privacy">سياسة الخصوصية</a></li>
        <li><a class="hover:text-white" href="/terms">الشروط والأحكام</a></li>
      </ul>
    </div>

    <div class="text-sm">
      <div class="font-semibold text-white">اتصل بنا</div>
      <ul class="mt-4 space-y-2 text-gray-300">
        <li class="flex items-center justify-between gap-2">
          <span class="text-gray-400">الإدارة</span>
          <a class="hover:text-white" href={phoneHref} dir="ltr">{site.contact.phone}</a>
        </li>
        <li class="flex items-center justify-between gap-2">
          <span class="text-gray-400">خدمة العملاء</span>
          <a class="hover:text-white" href={whatsappHref} target="_blank" rel="noreferrer" dir="ltr">{site.contact.whatsapp}</a>
        </li>
        {site.contact.whatsappAlt && (
          <li class="flex items-center justify-between gap-2">
            <span class="text-gray-400">خدمة العملاء (2)</span>
            <a class="hover:text-white" href={whatsappAltHref} target="_blank" rel="noreferrer" dir="ltr">{site.contact.whatsappAlt}</a>
          </li>
        )}
        {site.contact.landline?.length ? (
          <li class="flex items-start justify-between gap-2">
            <span class="text-gray-400">الهاتف الثابت</span>
            <div class="text-left" dir="ltr">
              {site.contact.landline.map((n, i) => (
                <>
                  <a class="hover:text-white" href={`tel:${n}`}>{n}</a>
                  {i < site.contact.landline.length - 1 ? <span class="text-gray-600"> • </span> : null}
                </>
              ))}
            </div>
          </li>
        ) : null}
        <li class="flex items-center justify-between gap-2">
          <span class="text-gray-400">البريد</span>
          <a class="hover:text-white" href={mailHref}>{site.contact.email}</a>
        </li>
      </ul>

      {(site.appLinks.android || site.appLinks.ios) && (
        <div class="mt-6">
          <div class="font-semibold text-white">روابط التطبيق</div>
          <div class="mt-3 flex flex-wrap gap-2">
            {site.appLinks.android && (
              <a class="btn-secondary px-4 py-2" href={site.appLinks.android} target="_blank" rel="noreferrer">
                Android
              </a>
            )}
            {site.appLinks.ios && (
              <a class="btn-secondary px-4 py-2" href={site.appLinks.ios} target="_blank" rel="noreferrer">
                iOS
              </a>
            )}
          </div>
        </div>
      )}
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container flex flex-col items-start justify-between gap-2 py-6 text-xs text-gray-500 md:flex-row md:items-center">
      <div>© {new Date().getFullYear()} {site.name}. جميع الحقوق محفوظة.</div>
      <div>الموقع التعريفي الرسمي.</div>
    </div>
  </div>
</footer>
